# Application Port
PORT=5000

# PostgreSQL Connection URL
# Example Neon: postgresql://username:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require
# Example Local: postgresql://postgres:postgres@localhost:5432/healthcare_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/healthcare_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_should_be_long_and_random
JWT_EXPIRES_IN=24h
